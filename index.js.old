app.post(
  "/addMultipleVenderBillItem",
  checkPermission("vendor_bill_item_add"),
  (req, res) => {
    const { vender_bill_id, items } = req.body;

    if (!vender_bill_id || !items || items.length === 0) {
      logger.warn("Invalid input data in /addMultipleVenderBillItem");
      return res.status(400).json({ message: "Invalid data" });
    }

    const values = items.map((item) => [
      vender_bill_id,
      item.material_id,
      item.price,
      item.quantity,
      item.sub_total,
    ]);

    const sql = `
    INSERT INTO vender_bill_item (vender_bill_id, material_id, price,quantity,sub_total) VALUES ?`;

    req.db.query(sql, [values], (err, result) => {
      if (err) {
        console.error(err);
        logger.error("DB error in /addMultipleVenderBillItem", err);
        return res.status(500).json({ message: "Insert failed" });
      }

      res.json({ success: true, inserted: result.affectedRows });
    });
  },
);

