    const venderId = req.params.id;

    req.db.query(
      "SELECT vm.id,v.id AS vender_id,v.name AS vender_name,m.id AS material_id,m.name AS material_name,vm.price FROM vender_material vm JOIN vender v ON vm.vendor_id = v.id JOIN material m ON vm.material_id = m.id WHERE v.id = ?",
      [venderId],
      (err, result) => {
        if (err) {
          console.error("Error fetching vender material data:", err);
          logger.error("DB error in /getVenderMaterialUsingVenderId/:id", err);
          res.status(500).json({ error: "Internal Server Error" });
          return;
        }
        console.log(result);
        res.json(result);
        console.log("vender material records fetched successfully");
      },
    );
  },
);

