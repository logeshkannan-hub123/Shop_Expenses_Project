// write logic to wtore request and response info to mongodb

// Custom logging middleware
function generateShortId() {
  return `REQ-${Date.now()}-${Math.floor(Math.random() * 1000)}`;
}

app.use(async (req, res, next) => {
  const startHrTime = process.hrtime();
  const customId = generateShortId(); // Generate your memorable ID

  // Capture request details
  const logData = {
    _id: customId,
    method: req.method,
    url: req.url,
    headers: req.headers,
    body: req.body,
    timestamp: new Date(),
  };

  // Modify the response.send method to capture response details
  const originalSend = res.send;
  res.send = function (body) {
    const elapsedHrTime = process.hrtime(startHrTime);
    const elapsedTimeInMs = (
      elapsedHrTime[0] * 1000 +
      elapsedHrTime[1] / 1e6
    ).toFixed(3);

    logData.response = {
      _id: customId,
      statusCode: res.statusCode,
      body: body,
      responseTimeMs: elapsedTimeInMs,
    };

    // Insert log data into MongoDB
    // const dbConnection = getDb();
    // dbConnection
    //   .collection("request_logs")
    //   .insertOne(logData)
    //   .then(() => console.log("Request/Response logged to MongoDB"))
    //   .catch((err) => console.error("Failed to log to MongoDB", err));

    originalSend.call(res, body);
  };

  // Insert log data into MongoDB
  res.on("finish", () => {
    const dbConnection = getDb();
    dbConnection
      .collection("request_logs")
      .insertOne(logData)
      .then(() => console.log("Request/Response logged to MongoDB"))
      .catch((err) => console.error("Failed to log to MongoDB", err));
  });

  next();
});

// middlewares/checkPermission.js
export const checkPermission = (permissionName) => {
  return (req, res, next) => {
    if (!req.isAuthenticated()) {
      return res.status(401).json({ message: "Unauthorized" });
    }

    const userId = req.user.user_id;

    const sql = `
      SELECT p.name
      FROM permission p
      JOIN role_permission rp ON rp.permission_id = p.id
      JOIN user_role ur ON ur.role_id = rp.role_id
      join userregistration u on u.id=ur.user_id
      WHERE u.user_id = ? AND p.name = ?
    `;

    req.db.query(sql, [userId, permissionName], (err, result) => {
      if (err) {
        return res.status(500).json({ message: "Permission check failed" });
      }

      if (result[0].count === 0) {
        return res.status(403).json({ message: "Access denied" });
      }

      next();
    });
  };
};

app.use(passport.initialize());
app.use(passport.session());
app.use((req, res, next) => {
  req.db = pool;
  next();
});

app.use(async (req, res, next) => {
  if (req.isAuthenticated()) {
    next();
  } else {
    if (
      req.url != "/login.html" &&
      req.url !== "/Registration.html" &&
      (req.url.endsWith(".html") || req.url === "/")
    ) {
      res.redirect("/login.html");
    } else {
      next();
    }
  }
  //check if authenticated; if not redirect to /login.html
});

app.get("/logout", (req, res, next) => {
  req.logout((err) => {
    if (err) return next(err);

    req.session.destroy(() => {
      res.redirect("/login.html");
    });
  });
});

app.post("/login", (req, res, next) => {
  passport.authenticate("local", (err, user, info) => {
    if (err) {
      return res.status(500).json({ message: "Server error" });
    }

    if (!user) {
      return res.status(401).json({
        message: "Invalid credentials please Register",
      });
    }

    req.logIn(user, (err) => {
      if (err) {
        return res.status(500).json({ message: "Login error" });
      }

      return res.status(200).json({
        message: "Login successful",
      });
    });
  })(req, res, next);
});

