app.post("/addMaterial", checkPermission("material_create"), (req, res) => {
  const { name, quantity_of_measure, unit_quantity } = req.body;
  const query =
    "INSERT INTO material (name, quantity_of_measure, unit_quantity) VALUES (?, ?, ?)";
  req.db.query(
    query,
    [name, quantity_of_measure, unit_quantity],
    (err, results) => {
      if (err) {
        console.error("Error adding material:", err);
        logger.error("DB error in /addMaterial", err);
        return res.status(500).json({ error: "Internal server error" });
      }
      console.log("Material added successfully:", results);
      res.status(201).json({ message: "Material added successfully" });
    },
  );
});

