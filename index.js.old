passport.use(
  "facebook",
  new FacebookStrategy(
    {
      clientID: process.env.FACEBOOK_APP_ID,
      clientSecret: process.env.FACEBOOK_SECRET_ID,
      callbackURL: "/auth/facebook/callback",
      profileFields: ["id", "displayName"],
      passReqToCallback: true,
    },
    (req, accessToken, refreshToken, profile, done) => {
      const userId = profile.id;
      const name = profile.displayName || null;
      const loginType = "facebook";

      const user = {
        user_id: userId,
        User_name: name,
        login_type: loginType,
      };

      req.session.userId = user.user_id;
      req.session.name = user.User_name;
      req.session.loginType = user.login_type;
      req.session.userSavedInDb = false;

      try {
        req.db.query(
          "SELECT * FROM userregistration WHERE name = ?",
          [name],
          (err, results) => {
            if (err) {
              req.session.userSavedInDb = false;
              req.session.save(() => {
                return done(null, user);
              });
            }

            // 🆕 New user
            if (results.length === 0) {
              req.db.query(
                "INSERT INTO userregistration (user_id, password, login_type,name) VALUES (?,?, ?, ?)",
                [userId, null, loginType, name],
                (err) => {
                  if (err) {
                    req.session.userSavedInDb = false;
                  } else {
                    req.session.userSavedInDb = true;
                  }
                  req.session.save(() => {
                    return done(null, user);
                  });
                },
              );
            } else {
              req.session.userSavedInDb = true;

              req.session.save(() => {
                return done(null, user);
              });
            }
          },
        );
      } catch (error) {
        req.session.userSavedInDb = false;
        req.session.save(() => {
          return done(null, user);
        });
      }
    },
  ),
);

