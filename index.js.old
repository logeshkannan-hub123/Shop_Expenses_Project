app.use(async (req, res, next) => {
  try {
    // Borrow a connection from the pool
    pool.getConnection((err, connection) => {
      if (err) {
        console.error("Error getting connection from pool:", err);
        res.status(500).send("Database connection error");
      } else {
        req.db = connection;
        // Return the connection to the pool when the response is finished
        res.on("finish", () => req.db.release());
        res.on("close", () => req.db.release());
        next();
      }
    });
  } catch (error) {
    console.error("Pool connection error:", error);
    res.status(500).send("Database connection pool error");
  }
});

const logDir = path.join(process.cwd(), "logs");
if (!fs.existsSync(logDir)) {
  fs.mkdirSync(logDir);
}
const logFormat = winston.format.combine(
  winston.format.timestamp({ format: "YYYY-MM-DD HH:mm:ss" }),
  winston.format.errors({ stack: true }),
  winston.format.json(),
);

export const logger = winston.createLogger({
  level: process.env.LOG_LEVEL || "debug",
  format: logFormat,
  defaultMeta: { service: "billing-app" },
  transports: [
    // 🔹 Console (all levels)
    new winston.transports.Console({
      level: "debug",
      format: winston.format.combine(
        winston.format.colorize(),
        winston.format.simple(),
      ),
    }),

    // 🔹 Debug logs
    new DailyRotateFile({
      filename: path.join(logDir, "debug-%DATE%.log"),
      datePattern: "YYYY-MM-DD",
      level: "debug",
      maxSize: "10m",
      maxFiles: "7d",
    }),

    // 🔹 Warning logs
    new DailyRotateFile({
      filename: path.join(logDir, "warn-%DATE%.log"),
      datePattern: "YYYY-MM-DD",
      level: "warn",
      maxSize: "10m",
      maxFiles: "14d",
    }),

    // 🔹 Info logs
    new DailyRotateFile({
      filename: path.join(logDir, "app-%DATE%.log"),
      datePattern: "YYYY-MM-DD",
      level: "info",
      maxSize: "10m",
      maxFiles: "14d",
    }),

    // 🔹 Error logs
    new DailyRotateFile({
      filename: path.join(logDir, "error-%DATE%.log"),
      datePattern: "YYYY-MM-DD",
      level: "error",
      maxSize: "10m",
      maxFiles: "30d",
    }),
  ],
  exitOnError: false,
});

export const httpLogger = morgan(
  ":method :url :status :res[content-length] - :response-time ms",
  {
    stream: {
      write: (message) => logger.info(message.trim()),
    },
  },
);
app.use(httpLogger);

export const errorLogger = (err, req, res, next) => {
  logger.error({
    message: err.message,
    stack: err.stack,
    url: req.originalUrl,
    method: req.method,
    ip: req.ip,
  });

  res.status(500).json({ message: "Internal Server Error" });
};

process.on("uncaughtException", (err) => {
  logger.error("Uncaught Exception", err);
});

process.on("unhandledRejection", (reason) => {
  logger.error("Unhandled Rejection", reason);
});

app.get("/hasPermission/:name", (req, res) => {
  if (!req.isAuthenticated()) {
    return res.json({ allowed: false });
  }

  const userId = req.user.user_id;
  const permissionName = req.params.name;

  const sql = `
    SELECT COUNT(*) AS count
    FROM permission p
    JOIN role_permission rp ON rp.permission_id = p.id
    JOIN user_role ur ON ur.role_id = rp.role_id
    JOIN userregistration u ON u.id = ur.user_id
    WHERE u.user_id = ? AND p.name = ?
  `;

  req.db.query(sql, [userId, permissionName], (err, result) => {
    if (err) return res.json({ allowed: false });
    res.json({ allowed: result[0].count > 0 });
  });
});

app.get("/getUserRegistration", checkPermission("user_view"), (req, res) => {
  req.db.query("SELECT * FROM userregistration", (err, results) => {
    if (err) {
      console.error("Error fetching registration data:", err);
      return;
    }
    console.log(results);
    res.json(results);
    console.log("Registration records fetched successfully");
  });
});

app.post("/addUserRegistration", checkPermission("user_create"), (req, res) => {
  const { user_id, password, email_id } = req.body;
  const sql =
    "INSERT INTO userregistration (user_id,email_id, password) VALUES (?,?,?)";

  let hash = crypto.createHash("sha512").update(password).digest("hex");

  req.db.query(sql, [user_id, email_id, hash], (err, result) => {
    if (err) {
      if (err.code === "ER_DUP_ENTRY") {
        return res.status(400).json({ error: "User already exists" });
      }
      return res.status(500).json({
        error: "registration will failed please fill correct proper field",
      });
    }
    res.redirect("/login.html");
  });
});

