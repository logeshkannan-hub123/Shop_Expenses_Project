app.put(
  "/updateVenderBill/:id",
  checkPermission("vendor_bill_update"),
  (req, res) => {
    const { id } = req.params;
    const { vendor_id, date, total_amount, paid_amount, bill_status } =
      req.body;

    if (
      !vendor_id ||
      !date ||
      total_amount === undefined ||
      paid_amount === undefined ||
      !bill_status
    ) {
      logger.warn("Invalid input data in /updateVenderBill/:id");
      return res.status(400).json({ message: "Invalid input data" });
    }

    const sql = `
    UPDATE vender_bill
    SET vendor_id = ?, date = ?, total_amount = ?, paid_amount = ?, bill_status = ?
    WHERE id = ?
  `;

    req.db.query(
      sql,
      [vendor_id, date, total_amount, paid_amount, bill_status, id],
      (err, result) => {
        if (err) {
          console.error("DB ERROR:", err);
          logger.error("DB error in /updateVenderBill/:id", err);
          return res.status(500).json({ message: "Database error" });
        }

        res.json({ success: true });
      },
    );
  },
);

