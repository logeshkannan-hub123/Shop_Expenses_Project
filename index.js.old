);

passport.use(
  "local",
  new Strategy(
    {
      usernameField: "user_id",
      passwordField: "password",
      passReqToCallback: true,
    },
    (req, user_id, password, cb) => {
      try {
        const hash = crypto.createHash("sha512").update(password).digest("hex");

        req.db.query(
          "SELECT * FROM userregistration WHERE user_id = ? AND password = ?",
          [user_id, hash],
          (err, results) => {
            if (err) return cb(err);
            if (!results.length)
              return cb(null, false, {
                message: "Invalid credentials please Register",
              });

            return cb(null, results[0]);
          },
        );
      } catch (err) {
        return cb(err);
      }
    },
  ),
);

passport.use(
  "google",
  new GoogleStrategy(
    {
      clientID: process.env.GOOGLE_CLIENT_ID,
      clientSecret: process.env.GOOGLE_CLIENT_SECRET,
      callbackURL: "/auth/google/secrets",
      passReqToCallback: true, // ✅ IMPORTANT
    },
    (req, accessToken, refreshToken, profile, done) => {
      const userId = profile.id;
      const email = profile.email || "";
      const loginType = "google";

      const user = {
        user_id: userId,
        email_id: email,
        login_type: loginType,
      };

      // ✅ SET SESSION HERE
      req.session.userId = user.user_id;
      req.session.email = user.email_id;
      req.session.loginType = user.login_type;
      req.session.userSavedInDb = false;

      /*

      if valid profile.email is available, save session

      try to insert user into db
      if error in db insert, save in session that user is not saved; otherwise save in session that user in db is updated
      call done when all work is done


      */

      try {
        req.db.query(
          "SELECT * FROM userregistration WHERE email_id = ?",
          [email],
          (err, results) => {
            if (err) {
              req.session.userSavedInDb = false;
              req.session.save(() => {
                return done(null, user);
              });
            }
            // ✅ NEW USER
            if (results.length === 0) {
              req.db.query(
                "INSERT INTO userregistration (user_id, email_id, password,login_type) VALUES (?, ?, ?,?)",
                [userId, email, null, loginType],
                (err) => {
                  if (err) {
                    req.session.userSavedInDb = false;
                  } else {
                    req.session.userSavedInDb = true;
                  }
                  req.session.save(() => {
                    return done(null, user);
                  });
                },
              );
            }
            // ✅ EXISTING USER
            else {
              // ✅ SET SESSION HERE
              req.session.userSavedInDb = true;

              req.session.save(() => {
                return done(null, user);
              });
            }
          },
        );
      } catch (error) {
        let x = error;
        req.session.userSavedInDb = false;
        req.session.save(() => {
          return done(null, user);
        });
      }
    },
  ),
);

